#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <DHT11.h>
#include <Servo.h>
#include <math.h>

// =====================================================================
//  SMART GREENHOUSE BAYAM - Arduino Mega 2560
//  VERSI TANPA ULTRASONIK & BUZZER + KONTROL MANUAL POMPA
//
//  KONTROL MANUAL
//   Serial Monitor (9600 baud, pilih "Newline"), ketik lalu Enter:
//     1 = pompa ON (otomatis OFF setelah 15 detik)
//     0 = pompa OFF sekarang
//     a = mode AUTO  (pompa menyala otomatis sesuai VPD)
//     m = mode MANUAL (pompa TIDAK menyala otomatis, hanya lewat perintah/tombol)
//     ? = tampilkan bantuan
//   Tombol (opsional): satu kaki ke D30, kaki lain ke GND.
//     Tekan sekali: pompa ON (15 detik), tekan lagi saat menyala: OFF.
//
//  PERHATIAN: tanpa sensor level air, pompa tidak tahu tangki kosong.
//  Isi tangki manual dan jangan jalankan pompa celup tanpa air.
// =====================================================================

#define USE_WATCHDOG false   // true = reset otomatis jika program macet (lihat catatan)
#if USE_WATCHDOG
#include <avr/wdt.h>
#endif

// ---------------- Objek ----------------
LiquidCrystal_I2C lcd(0x27, 16, 2);   // SDA = D20, SCL = D21
DHT11 dht11(2);                       // DHT11 di pin D2
Servo windowServo;

// ---------------- Pin ----------------
const int PIN_LED_R  = 4;
const int PIN_LED_G  = 5;
const int PIN_LED_B  = 6;
const int PIN_SERVO  = 9;
const int PIN_RELAY  = 24;            // Relay IN1 -> pompa
const int PIN_RELAY2 = 26;            // Relay IN2 (cadangan, dijaga OFF)
const int PIN_BUTTON = 30;            // Tombol opsional (ke GND, INPUT_PULLUP)

// ---------------- Konfigurasi relay ----------------
// Jika pompa menyala saat Arduino baru dinyalakan / terbalik, ubah menjadi false.
const bool RELAY_ACTIVE_LOW = true;
const int RELAY_ON  = RELAY_ACTIVE_LOW ? LOW : HIGH;
const int RELAY_OFF = RELAY_ACTIVE_LOW ? HIGH : LOW;

// ---------------- Servo jendela ----------------
const int ANGLE_CLOSED = 0;
const int ANGLE_OPEN   = 60;
const unsigned long SERVO_STEP_MS      = 15;
const unsigned long SERVO_MIN_INTERVAL = 30000;

// ---------------- Ambang VPD bayam fase vegetatif (kPa) ----------------
const float WET_ON  = 0.65;
const float WET_OFF = 0.85;
const float DRY_ON  = 1.45;
const float DRY_OFF = 1.25;

// ---------------- Ambang suhu (C) ----------------
const float TEMP_HEAT_ON  = 35.0;
const float TEMP_HEAT_OFF = 33.0;

// ---------------- Pompa ----------------
const unsigned long PUMP_MAX_ON_MS    = 15000;    // maksimal 1 siklus otomatis
const unsigned long MANUAL_MAX_ON_MS  = 15000;    // maksimal 1 kali nyala manual
const unsigned long PUMP_REST_MS      = 60000;    // istirahat antar siklus otomatis
const unsigned long PUMP_MAX_TOTAL_MS = 90000;    // jatah otomatis per jam
const unsigned long BUDGET_WINDOW_MS  = 3600000UL;

// ---------------- Waktu lain ----------------
const unsigned long DHT_INTERVAL_MS = 2500;
const unsigned long ENV_STALE_MS    = 10000;
const unsigned long LCD_REFRESH_MS  = 500;
const unsigned long LCD_PAGE_MS     = 3000;
const unsigned long LOG_MS          = 2000;
const unsigned long DEBOUNCE_MS     = 40;
const int DHT_MAX_FAIL = 3;

// ---------------- Status ----------------
enum PumpState { PUMP_IDLE, PUMP_ON, PUMP_COOLDOWN };

int vpdZone = 0;                      // 0 = OK, 1 = DRY, 2 = WET

float temperatureC = 0, humidityRH = 0, vpdKpa = 0;
bool envValid = false;
int dhtFailCount = 0;
int dhtLastError = 0;
unsigned long lastDhtMs = 0, lastEnvOkMs = 0;

PumpState pumpState = PUMP_IDLE;
bool pumpOn = false;
bool manualRun = false;               // true = pompa sedang menyala karena perintah manual
bool autoMode = true;                 // false = pompa tidak menyala otomatis
bool budgetBlocked = false;
unsigned long pumpStartMs = 0, pumpRestStartMs = 0;
unsigned long pumpTotalMs = 0, budgetWindowStart = 0;

int windowAngle = ANGLE_CLOSED;
int windowTarget = ANGLE_CLOSED;
bool heatFlag = false;
bool windowMovedOnce = false;
unsigned long lastWindowMoveMs = 0, lastServoStepMs = 0;

unsigned long lastLcdMs = 0, lastLogMs = 0;

// =====================================================================
//  Utilitas
// =====================================================================
void setLedRgb(bool r, bool g, bool b) {
  digitalWrite(PIN_LED_R, r ? HIGH : LOW);
  digitalWrite(PIN_LED_G, g ? HIGH : LOW);
  digitalWrite(PIN_LED_B, b ? HIGH : LOW);
}

void pompaNyala(unsigned long now) {
  pumpOn = true;
  pumpStartMs = now;
  digitalWrite(PIN_RELAY, RELAY_ON);
}

void pompaMati(unsigned long now) {
  if (pumpOn) pumpTotalMs += now - pumpStartMs;
  pumpOn = false;
  digitalWrite(PIN_RELAY, RELAY_OFF);
}

float hitungVpdKpa(float suhuC, float rhPersen) {
  float es = 0.6108 * exp((17.27 * suhuC) / (suhuC + 237.3));
  float vpd = es * (1.0 - (rhPersen / 100.0));
  if (vpd < 0.0) vpd = 0.0;
  return vpd;
}

void updateZona(float vpd) {
  if (vpdZone == 1) {
    if (vpd <= DRY_OFF) vpdZone = 0;
  } else if (vpdZone == 2) {
    if (vpd >= WET_OFF) vpdZone = 0;
  } else {
    if (vpd >= DRY_ON) vpdZone = 1;
    else if (vpd <= WET_ON) vpdZone = 2;
  }
}

// =====================================================================
//  Kontrol manual: perintah Serial & tombol
// =====================================================================
void pompaManualNyala() {
  unsigned long now = millis();
  if (pumpOn) {
    Serial.println("Pompa sudah menyala.");
    return;
  }
  manualRun = true;
  pompaNyala(now);
  pumpState = PUMP_ON;
  Serial.println("MANUAL: pompa ON (otomatis OFF dalam 15 detik)");
}

void pompaManualMati() {
  unsigned long now = millis();
  bool tadiNyala = pumpOn;
  manualRun = false;
  pompaMati(now);
  pumpState = PUMP_COOLDOWN;          // tahan pompa otomatis sebentar
  pumpRestStartMs = now;
  if (tadiNyala) Serial.println("MANUAL: pompa OFF");
}

void tampilBantuan() {
  Serial.println("Perintah: 1=pompa ON, 0=pompa OFF, a=mode AUTO, m=mode MANUAL, ?=bantuan");
}

void bacaSerial() {
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '1') pompaManualNyala();
    else if (c == '0') pompaManualMati();
    else if (c == 'a' || c == 'A') { autoMode = true; Serial.println("MODE: AUTO"); }
    else if (c == 'm' || c == 'M') { autoMode = false; Serial.println("MODE: MANUAL (pompa tidak nyala otomatis)"); }
    else if (c == '?') tampilBantuan();
  }
}

void bacaTombol() {
  static bool lastRead = HIGH;
  static bool stable = HIGH;
  static unsigned long lastChange = 0;
  unsigned long now = millis();
  bool r = digitalRead(PIN_BUTTON);
  if (r != lastRead) { lastRead = r; lastChange = now; }
  if (now - lastChange > DEBOUNCE_MS && r != stable) {
    stable = r;
    if (stable == LOW) {                       // tombol ditekan
      if (pumpOn) pompaManualMati();
      else pompaManualNyala();
    }
  }
}

// =====================================================================
//  1. Baca suhu & kelembapan (DHT11) - tanpa delay()
// =====================================================================
void bacaLingkungan() {
  unsigned long now = millis();
  if (now - lastDhtMs >= DHT_INTERVAL_MS) {
    lastDhtMs = now;
    int t = 0, h = 0;
    int result = dht11.readTemperatureHumidity(t, h);
    if (result == 0 && h > 0 && h <= 100) {
      temperatureC = (float)t;
      humidityRH = (float)h;
      vpdKpa = hitungVpdKpa(temperatureC, humidityRH);
      updateZona(vpdKpa);
      dhtFailCount = 0;
      lastEnvOkMs = now;
      envValid = true;
    } else {
      dhtLastError = result;
      if (dhtFailCount < 100) dhtFailCount++;
    }
  }
  if (dhtFailCount >= DHT_MAX_FAIL) envValid = false;
  if (envValid && now - lastEnvOkMs > ENV_STALE_MS) envValid = false;
}

// =====================================================================
//  2. Pompa: pengaman keras + logika otomatis
// =====================================================================
void kontrolMisting() {
  unsigned long now = millis();

  // Reset jatah tiap jam
  if (now - budgetWindowStart >= BUDGET_WINDOW_MS) {
    budgetWindowStart = now;
    pumpTotalMs = 0;
  }
  unsigned long terpakai = pumpTotalMs + (pumpOn ? now - pumpStartMs : 0);
  budgetBlocked = terpakai >= PUMP_MAX_TOTAL_MS;

  // ---- PENGAMAN KERAS: apa pun mode-nya, pompa tidak boleh melewati batas waktu ----
  if (pumpOn) {
    unsigned long batas = manualRun ? MANUAL_MAX_ON_MS : PUMP_MAX_ON_MS;
    if (now - pumpStartMs >= batas) {
      pompaMati(now);
      manualRun = false;
      pumpRestStartMs = now;
      pumpState = PUMP_COOLDOWN;
      Serial.println("Pompa dihentikan: batas waktu tercapai");
    }
  }

  // ---- Pompa menyala karena perintah manual: abaikan VPD & jatah ----
  if (manualRun) return;

  // ---- Mode manual: pompa tidak menyala otomatis ----
  if (!autoMode) {
    if (pumpOn) pompaMati(now);
    if (pumpState == PUMP_ON) { pumpState = PUMP_COOLDOWN; pumpRestStartMs = now; }
    else if (pumpState == PUMP_COOLDOWN && now - pumpRestStartMs >= PUMP_REST_MS) pumpState = PUMP_IDLE;
    return;
  }

  bool boleh = envValid && !budgetBlocked;
  if (!boleh) {
    if (pumpOn) pompaMati(now);
    if (pumpState == PUMP_ON) { pumpState = PUMP_COOLDOWN; pumpRestStartMs = now; }
    else if (pumpState == PUMP_COOLDOWN && now - pumpRestStartMs >= PUMP_REST_MS) pumpState = PUMP_IDLE;
    return;
  }

  switch (pumpState) {
    case PUMP_IDLE:
      if (vpdZone == 1) { pompaNyala(now); pumpState = PUMP_ON; }
      break;
    case PUMP_ON:
      if (vpdZone != 1) {
        pompaMati(now);
        pumpRestStartMs = now;
        pumpState = PUMP_COOLDOWN;
      }
      break;
    case PUMP_COOLDOWN:
      if (now - pumpRestStartMs >= PUMP_REST_MS) pumpState = PUMP_IDLE;
      break;
  }
}

// =====================================================================
//  3. Servo jendela (gerak halus tanpa delay)
// =====================================================================
void kontrolServoJendela() {
  unsigned long now = millis();

  if (envValid) {
    if (temperatureC >= TEMP_HEAT_ON) heatFlag = true;
    else if (temperatureC <= TEMP_HEAT_OFF) heatFlag = false;

    int desired = windowTarget;
    if (heatFlag || vpdZone == 2) desired = ANGLE_OPEN;
    else if (vpdZone == 1) desired = ANGLE_CLOSED;

    if (desired != windowTarget && (!windowMovedOnce || now - lastWindowMoveMs >= SERVO_MIN_INTERVAL)) {
      windowTarget = desired;
      lastWindowMoveMs = now;
      windowMovedOnce = true;
    }
  }

  if (windowAngle != windowTarget && now - lastServoStepMs >= SERVO_STEP_MS) {
    lastServoStepMs = now;
    windowAngle += (windowTarget > windowAngle) ? 1 : -1;
    windowServo.write(windowAngle);
  }
}

// =====================================================================
//  4. Indikator: LED dan LCD
// =====================================================================
void updateLed() {
  unsigned long now = millis();
  if (pumpOn) {
    bool on = (now % 600) < 300;
    setLedRgb(LOW, on, on);                            // Cyan berkedip: pompa menyala
  } else if (!envValid) {
    setLedRgb(HIGH, LOW, LOW);                         // Merah: sensor error
  } else if (vpdZone == 1 && autoMode && budgetBlocked) {
    bool on = (now % 800) < 400;
    setLedRgb(on, on, LOW);                            // Kuning berkedip: kering, jatah habis
  } else if (vpdZone == 1) {
    setLedRgb(HIGH, HIGH, LOW);                        // Kuning: kering
  } else if (vpdZone == 2) {
    setLedRgb(LOW, LOW, HIGH);                         // Biru: lembap
  } else {
    setLedRgb(LOW, HIGH, LOW);                         // Hijau: optimal
  }
}

void lcdLines(const char *a, const char *b) {
  char buf[17];
  snprintf(buf, sizeof(buf), "%-16s", a); lcd.setCursor(0, 0); lcd.print(buf);
  snprintf(buf, sizeof(buf), "%-16s", b); lcd.setCursor(0, 1); lcd.print(buf);
}

void updateLcd() {
  unsigned long now = millis();
  if (now - lastLcdMs < LCD_REFRESH_MS) return;
  lastLcdMs = now;

  char l1[24], l2[24], a[10];
  const char *zona = (vpdZone == 1) ? "DRY" : (vpdZone == 2) ? "WET" : "OK ";
  bool halamanData = ((now / LCD_PAGE_MS) % 2 == 0);

  if (!envValid && halamanData) {
    lcdLines("Sensor Error!", "Check Wiring");
    return;
  }

  if (halamanData) {
    dtostrf(vpdKpa, 4, 2, a);
    snprintf(l1, sizeof(l1), "T:%dC RH:%d%%", (int)temperatureC, (int)humidityRH);
    snprintf(l2, sizeof(l2), "VPD:%s %s S%d", a, zona, windowAngle);
  } else {
    unsigned long terpakai = (pumpTotalMs + (pumpOn ? now - pumpStartMs : 0)) / 1000;
    snprintf(l1, sizeof(l1), "POMPA:%s %s", pumpOn ? (manualRun ? "MAN" : "ON ") : "OFF",
             windowAngle >= ANGLE_OPEN / 2 ? "BUKA" : "TUTUP");
    if (autoMode && budgetBlocked) snprintf(l2, sizeof(l2), "JATAH HABIS");
    else snprintf(l2, sizeof(l2), "%s J:%lu/%lus", autoMode ? "AUTO" : "MAN", terpakai, PUMP_MAX_TOTAL_MS / 1000);
  }
  lcdLines(l1, l2);
}

void updateIndikator() {
  updateLed();
  updateLcd();
}

// =====================================================================
//  Serial Monitor
// =====================================================================
void logSerial() {
  unsigned long now = millis();
  if (now - lastLogMs < LOG_MS) return;
  lastLogMs = now;

  if (!envValid) {
    Serial.print("DHT11 error: ");
    Serial.print(DHT11::getErrorString(dhtLastError));
  } else {
    Serial.print("Temperature: "); Serial.print(temperatureC, 0);
    Serial.print(" C\tHumidity: "); Serial.print(humidityRH, 0);
    Serial.print(" %\tVPD: "); Serial.print(vpdKpa, 2);
    Serial.print(" kPa\tZona: ");
    Serial.print(vpdZone == 1 ? "DRY" : (vpdZone == 2 ? "WET" : "OK"));
  }
  Serial.print("\tMode: "); Serial.print(autoMode ? "AUTO" : "MANUAL");
  Serial.print("\tPompa: "); Serial.print(pumpOn ? "ON " : "OFF");
  if (pumpOn) { Serial.print((now - pumpStartMs) / 1000); Serial.print("s"); }
  Serial.print("\tServo: "); Serial.print(windowAngle); Serial.println(" deg");
}

// =====================================================================
//  setup & loop
// =====================================================================
void setup() {
  // Relay dimatikan DULU sebelum pin dijadikan OUTPUT supaya pompa tidak sempat menyala
  digitalWrite(PIN_RELAY, RELAY_OFF);
  digitalWrite(PIN_RELAY2, RELAY_OFF);
  pinMode(PIN_RELAY, OUTPUT);
  pinMode(PIN_RELAY2, OUTPUT);

  pinMode(PIN_BUTTON, INPUT_PULLUP);

  pinMode(PIN_LED_R, OUTPUT);
  pinMode(PIN_LED_G, OUTPUT);
  pinMode(PIN_LED_B, OUTPUT);
  setLedRgb(LOW, LOW, LOW);

  windowServo.attach(PIN_SERVO);
  windowServo.write(ANGLE_CLOSED);

  Serial.begin(9600);

  // Mencegah program macet selamanya jika jalur I2C LCD terganggu noise pompa/relay
  Wire.begin();
#ifdef WIRE_HAS_TIMEOUT
  Wire.setWireTimeout(25000, true);
#endif

  lcd.init();
  lcd.backlight();
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Smart Greenhouse");
  lcd.setCursor(0, 1);
  lcd.print("Initializing...");
  delay(2000);                 // satu-satunya delay: hanya saat boot
  lcd.clear();

  tampilBantuan();

#if USE_WATCHDOG
  wdt_enable(WDTO_4S);         // reset jika loop() macet > 4 detik
#endif
}

void loop() {
#if USE_WATCHDOG
  wdt_reset();
#endif
  bacaSerial();           // perintah manual dari Serial Monitor
  bacaTombol();           // tombol manual (opsional)
  bacaLingkungan();       // DHT11 tiap 2,5 detik -> VPD & zona
  kontrolMisting();       // pompa: pengaman waktu + otomatis
  kontrolServoJendela();  // jendela
  updateIndikator();      // LED dan LCD
  logSerial();

  // Pastikan relay selalu sesuai status program (cegah pin "nyangkut")
  digitalWrite(PIN_RELAY, pumpOn ? RELAY_ON : RELAY_OFF);
}

